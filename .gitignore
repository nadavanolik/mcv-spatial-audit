# Local dev venv (laptop). Not the VM environment — see requirements.txt.
.venv/
__pycache__/
*.pyc

# Never commit: bulk artefacts and secrets (CLAUDE.md guardrails)
data/
out/
*.parquet
.env
hf_token*

# Exception: committed run outputs under results/ ARE tracked -- the summary
# CSVs and the small (~1.8MB total) raw score parquets, so all four analyses
# reproduce on any laptop with no GPU. Only bulk/regenerable parquets in out/
# stay ignored.
!results/**/*.parquet
